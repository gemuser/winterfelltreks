{
    "name":  "winterfell/treks-expedition",
    "type":  "project",
    "description":  "Winterfell Treks \u0026 Expedition - Premier High-Altitude Mountaineering Platform",
    "keywords":  [
                     "laravel",
                     "tourism",
                     "trekking",
                     "expedition",
                     "himalaya"
                 ],
    "license":  "proprietary",
    "require":  {
                    "php":  "^8.2",
                    "intervention/image":  "^3.0",
                    "laravel/framework":  "^13.0",
                    "laravel/sanctum":  "^4.0",
                    "laravel/scout":  "^10.0",
                    "spatie/laravel-medialibrary":  "^11.0",
                    "spatie/laravel-sitemap":  "^7.0",
                    "spatie/laravel-sluggable":  "^3.0"
                },
    "require-dev":  {
                        "fakerphp/faker":  "^1.23",
                        "laravel/pint":  "^1.13",
                        "laravel/sail":  "^1.26",
                        "mockery/mockery":  "^1.6",
                        "nunomaduro/collision":  "^8.0",
                        "pestphp/pest":  "^4.0",
                        "pestphp/pest-plugin-laravel":  "^4.0"
                    },
    "autoload":  {
                     "psr-4":  {
                                   "App\\":  "app/",
                                   "Database\\Factories\\":  "database/factories/",
                                   "Database\\Seeders\\":  "database/seeders/"
                               }
                 },
    "autoload-dev":  {
                         "psr-4":  {
                                       "Tests\\":  "tests/"
                                   }
                     },
    "scripts":  {
                    "post-autoload-dump":  [
                                               "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
                                               "@php artisan package:discover --ansi"
                                           ],
                    "post-update-cmd":  [
                                            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
                                        ],
                    "post-root-package-install":  [
                                                      "@php -r \"file_exists(\u0027.env\u0027) || copy(\u0027.env.example\u0027, \u0027.env\u0027);\""
                                                  ],
                    "post-create-project-cmd":  [
                                                    "@php artisan key:generate --ansi"
                                                ],
                    "dev":  [
                                "Composer\\Config::disableProcessTimeout",
                                "npx concurrently -c \"#93c5fd,#c4b5fd,#fca5a5\" \"php artisan serve\" \"npm run dev\" \"php artisan queue:listen --tries=1\""
                            ],
                    "test":  [
                                 "@php artisan test"
                             ],
                    "lint":  [
                                 "@php artisan pint"
                             ]
                },
    "config":  {
                   "optimize-autoloader":  true,
                   "preferred-install":  "dist",
                   "sort-packages":  true,
                   "allow-plugins":  {
                                         "pestphp/pest-plugin":  true
                                     }
               },
    "minimum-stability":  "stable",
    "prefer-stable":  true
}